{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "description": "Fires daily at 6:00 PM Eastern Time to deallocate the automation VM",
        "recurrence": {
          "interval": 1,
          "frequency": "Day",
          "timeZone": "Eastern Standard Time",
          "schedule": { "hours": [18], "minutes": [0] }
        }
      }
    },
    "actions": {
      "HTTP": {
        "type": "Http",
        "description": "POST to ARM REST API to deallocate __VM_NAME__. Uses deallocate (not powerOff) to fully release compute and stop billing. VM context read from app settings.",
        "inputs": {
          "uri": "https://management.azure.com/subscriptions/@{appsetting('AZURE_SUBSCRIPTION_ID')}/resourceGroups/@{appsetting('VM_RESOURCE_GROUP')}/providers/Microsoft.Compute/virtualMachines/@{appsetting('VM_NAME')}/deallocate?api-version=2024-03-01",
          "method": "POST",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "identity": "__UAMI_RESOURCE_ID__",
            "audience": "https://management.azure.com/"
          }
        },
        "runAfter": {},
        "runtimeConfiguration": {
          "contentTransfer": { "transferMode": "Chunked" }
        }
      },
      "Condition": {
        "type": "If",
        "description": "200 = already deallocated (no-op), 202 = deallocate accepted async. Both indicate success.",
        "expression": {
          "or": [
            { "equals": ["@outputs('HTTP')['statusCode']", 200] },
            { "equals": ["@outputs('HTTP')['statusCode']", 202] }
          ]
        },
        "actions": {
          "Compose_Success": {
            "type": "Compose",
            "description": "Log VM deallocate success",
            "inputs": "SUCCESS | VM deallocate accepted | VM: @{appsetting('VM_NAME')} | Status: @{outputs('HTTP')['statusCode']} | Time: @{utcNow()}"
          }
        },
        "else": {
          "actions": {
            "Compose_Failure": {
              "type": "Compose",
              "description": "Log VM deallocate failure for troubleshooting",
              "inputs": "FAILED | VM deallocate rejected | VM: @{appsetting('VM_NAME')} | Status: @{outputs('HTTP')['statusCode']} | Time: @{utcNow()}"
            }
          }
        },
        "runAfter": {
          "HTTP": ["SUCCEEDED", "FAILED", "TIMEDOUT"]
        }
      }
    },
    "outputs": {}
  },
  "kind": "stateful"
}
